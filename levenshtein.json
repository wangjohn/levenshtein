      "go-vet",
      "workflow-lint",
      "self-test"
    ],
    "main": [
      "go-lint",
      "go-vet",
      "workflow-lint",
      "self-test",
      "go-vuln"
    ],
    "go-lint": [
      "go-lint"
    ],
    "go-vet": [
      "go-vet"
    ],
    "go-http": [
      "go-http"
    ],
    "go-sql": [
      "go-sql"
    ],
    "go-vuln": [
      "go-vuln"
    ],
    "workflow-lint": [
      "workflow-lint"
    ],
    "self-test": [
      "self-test"
    ]
  }
