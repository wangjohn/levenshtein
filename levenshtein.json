{
  "version": 1,
  "targets": {
    "root": {
      "dir": ".",
      "workspace": ".",
      "inputs": ["go.mod", "go.sum", ".go-version", "cmd", "internal"]
    },
    "runner": {
      "dir": "runner",
      "workspace": ".",
      "inputs": ["runner"]
    },
    "lint": {
      "dir": "runner/lint",
      "workspace": ".",
      "inputs": ["runner/lint", "runner/testdata/import-rules.json", "runner/testdata/imports-good", "runner/testdata/imports-bad", "runner/testdata/generate-fresh", "runner/testdata/generate-stale", "runner/testdata/apidiff", "runner/tools"]
    },
    "example": {
      "dir": "examples/rule-module",
      "workspace": ".",
      "inputs": ["examples/rule-module"]
    },
    "tools": {
      "dir": "runner/tools",
      "workspace": ".",
      "inputs": ["runner/tools"]
    },
    "workflows": {
      "dir": ".",
      "workspace": ".",
      "inputs": [".github/workflows"]
    },
    "actions": {
      "dir": ".",
      "workspace": ".",
      "inputs": [".github", "action.yml"]
    },
    "repository": {
      "dir": ".",
      "workspace": ".",
      "inputs": ["."]
    }
  },
  "environments": {
    "go": {"executor": "dagger"},
    "host": {"executor": "native"},
    "host-go": {"executor": "native"}
  },
  "checks": {
    "go-lint": {"kind": "go-lint", "targets": ["root", "runner", "lint", "example"], "environment": "go"},
    "go-vet": {"kind": "go-vet", "targets": ["root", "runner", "lint", "example"], "environment": "go"},
    "go-mod": {"kind": "go-mod", "targets": ["root", "lint", "tools", "example"], "environment": "go"},
    "go-http": {"kind": "go-http", "targets": ["root", "runner", "lint"], "environment": "go"},
    "go-sql": {"kind": "go-sql", "targets": ["root", "runner", "lint"], "environment": "go"},
    "go-vuln": {"kind": "go-vuln", "targets": ["root", "runner", "lint"], "environment": "go"},
    "workflow-lint": {"kind": "workflow-lint", "target": "workflows", "environment": "go"},
    "workflow-security": {"kind": "workflow-security", "target": "actions", "environment": "go"},
    "self-test": {"kind": "self-test", "target": "root", "environment": "go"},
    "semantic-lint": {"kind": "semantic-lint", "target": "repository", "environment": "host"},
    "native-go-lint": {"kind": "go-lint", "targets": ["root", "runner", "lint", "example"], "environment": "host-go"},
    "native-go-vet": {"kind": "go-vet", "targets": ["root", "runner", "lint", "example"], "environment": "host-go"},
    "native-go-mod": {"kind": "go-mod", "targets": ["root", "lint", "tools", "example"], "environment": "host-go"},
    "native-go-test": {"kind": "go-test", "targets": ["repository", "lint", "example"], "environment": "host-go"},
    "native-workflow-lint": {"kind": "workflow-lint", "target": "workflows", "environment": "host-go"},
    "native-workflow-security": {"kind": "workflow-security", "target": "actions", "environment": "host-go"},
    "go-imports": {"kind": "go-imports", "target": "root", "environment": "go", "imports": {"rules": [{"packages": ["./internal/gitchange"], "allow": ["std"], "reason": "gitchange is the leaf verify and semantic share, so it depends on the standard library alone"}, {"packages": ["./internal/semantic/..."], "deny": ["./internal/verify/...", "./cmd/...", "dagger.io/..."], "reason": "semantic-lint is a library internal/verify calls; it must not reach back into the runner or depend on Dagger"}, {"packages": ["./cmd/..."], "deny": ["./internal/semantic/...", "./internal/gitchange/...", "dagger.io/..."], "reason": "the CLI drives every check through internal/verify, which owns Dagger"}]}},
    "go-imports-lint": {"kind": "go-imports", "target": "lint", "environment": "go", "imports": {"rules": [{"packages": ["./..."], "deny": ["dagger.io/...", "dagger/..."], "reason": "the linter and levenshtein-gocheck build the same way on the host and in Dagger, so they never depend on the Dagger SDK"}, {"packages": ["./policy/..."], "allow": ["std", "golang.org/x/tools/go/..."], "reason": "the house rules are plain go/analysis analyzers, independent of Staticcheck and the upstream analyzers beside them"}, {"packages": ["./gocheck/..."], "allow": ["std", "golang.org/x/mod/..."], "reason": "levenshtein-gocheck needs no type checker or analyzer, so it stays a small, fast build"}]}},
    "native-go-imports": {"kind": "go-imports", "target": "root", "environment": "host-go", "imports": {"rules": [{"packages": ["./internal/gitchange"], "allow": ["std"], "reason": "gitchange is the leaf verify and semantic share, so it depends on the standard library alone"}, {"packages": ["./internal/semantic/..."], "deny": ["./internal/verify/...", "./cmd/...", "dagger.io/..."], "reason": "semantic-lint is a library internal/verify calls; it must not reach back into the runner or depend on Dagger"}, {"packages": ["./cmd/..."], "deny": ["./internal/semantic/...", "./internal/gitchange/...", "dagger.io/..."], "reason": "the CLI drives every check through internal/verify, which owns Dagger"}]}},
    "native-go-imports-lint": {"kind": "go-imports", "target": "lint", "environment": "host-go", "imports": {"rules": [{"packages": ["./..."], "deny": ["dagger.io/...", "dagger/..."], "reason": "the linter and levenshtein-gocheck build the same way on the host and in Dagger, so they never depend on the Dagger SDK"}, {"packages": ["./policy/..."], "allow": ["std", "golang.org/x/tools/go/..."], "reason": "the house rules are plain go/analysis analyzers, independent of Staticcheck and the upstream analyzers beside them"}, {"packages": ["./gocheck/..."], "allow": ["std", "golang.org/x/mod/..."], "reason": "levenshtein-gocheck needs no type checker or analyzer, so it stays a small, fast build"}]}},
    "go-apidiff": {"kind": "go-apidiff", "target": "example", "environment": "go"},
    "native-go-apidiff": {"kind": "go-apidiff", "target": "example", "environment": "host-go"},
    "go-mutation": {"kind": "go-mutation", "target": "repository", "environment": "go"},
    "go-mutation-lint": {"kind": "go-mutation", "target": "lint", "environment": "go", "mutation": {"accepted": "runner/lint/.levenshtein/mutation-accepted.json"}}
  },
  "runs": {
    "go-lint": {"checks": ["native-go-lint"]},
    "go-vet": {"checks": ["native-go-vet"]},
    "go-mod": {"checks": ["native-go-mod"]},
    "go-test": {"checks": ["native-go-test"]},
    "go-imports": {"checks": ["native-go-imports", "native-go-imports-lint"]},
    "go-apidiff": {"checks": ["native-go-apidiff"]},
    "go-http": {"checks": ["go-http"]},
    "go-sql": {"checks": ["go-sql"]},
    "go-vuln": {"checks": ["go-vuln"]},
    "workflow-lint": {"checks": ["native-workflow-lint"]},
    "workflow-security": {"checks": ["native-workflow-security"]},
    "self-test": {"checks": ["self-test"]},
    "semantic-lint": {"checks": ["semantic-lint"]},
    "mutation": {"checks": ["go-mutation", "go-mutation-lint"]},
    "branch": {"checks": ["native-go-lint", "native-go-vet", "native-go-mod", "native-go-imports", "native-go-imports-lint", "native-workflow-lint", "native-workflow-security"]},
    "pre-merge": {"checks": ["native-go-lint", "native-go-vet", "native-go-mod", "native-go-imports", "native-go-imports-lint", "native-workflow-lint", "native-workflow-security", "self-test"]},
    "branch-dagger": {"checks": ["go-lint", "go-vet", "go-mod", "go-imports", "go-imports-lint", "workflow-lint", "workflow-security"]},
    "main": {"checks": ["go-lint", "go-vet", "go-mod", "go-imports", "go-imports-lint", "workflow-lint", "workflow-security", "self-test", "go-vuln"], "rerun_checks": true}
  }
}
