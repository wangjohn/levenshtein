{
  "version": 1,
  "targets": {
    "root": {
      "dir": ".",
      "workspace": ".",
      "inputs": ["go.mod", "go.sum", ".go-version", "cmd", "internal"]
    },
    "runner": {
      "dir": "runner",
      "workspace": ".",
      "inputs": ["runner"]
    },
    "lint": {
      "dir": "runner/lint",
      "workspace": ".",
      "inputs": ["runner/lint"]
    },
    "workflows": {
      "dir": ".",
      "workspace": ".",
      "inputs": [".github/workflows"]
    },
    "repository": {
      "dir": ".",
      "workspace": ".",
      "inputs": ["."]
    }
  },
  "environments": {
    "go": {"executor": "dagger"},
    "host": {"executor": "native"}
  },
  "checks": {
    "go-lint/root": {"kind": "go-lint", "target": "root", "environment": "go"},
    "go-lint/runner": {"kind": "go-lint", "target": "runner", "environment": "go"},
    "go-lint/lint": {"kind": "go-lint", "target": "lint", "environment": "go"},
    "go-vet/root": {"kind": "go-vet", "target": "root", "environment": "go"},
    "go-vet/runner": {"kind": "go-vet", "target": "runner", "environment": "go"},
    "go-vet/lint": {"kind": "go-vet", "target": "lint", "environment": "go"},
    "go-http/root": {"kind": "go-http", "target": "root", "environment": "go"},
    "go-http/runner": {"kind": "go-http", "target": "runner", "environment": "go"},
    "go-http/lint": {"kind": "go-http", "target": "lint", "environment": "go"},
    "go-sql/root": {"kind": "go-sql", "target": "root", "environment": "go"},
    "go-sql/runner": {"kind": "go-sql", "target": "runner", "environment": "go"},
    "go-sql/lint": {"kind": "go-sql", "target": "lint", "environment": "go"},
    "go-vuln/root": {"kind": "go-vuln", "target": "root", "environment": "go"},
    "go-vuln/runner": {"kind": "go-vuln", "target": "runner", "environment": "go"},
    "go-vuln/lint": {"kind": "go-vuln", "target": "lint", "environment": "go"},
    "workflow-lint": {"kind": "workflow-lint", "target": "workflows", "environment": "go"},
    "self-test": {"kind": "self-test", "target": "root", "environment": "go"},
    "semantic-lint": {"kind": "semantic-lint", "target": "repository", "environment": "host"}
  },
  "runs": {
    "go-lint": {"checks": ["go-lint/root", "go-lint/runner", "go-lint/lint"]},
    "go-vet": {"checks": ["go-vet/root", "go-vet/runner", "go-vet/lint"]},
    "go-http": {"checks": ["go-http/root", "go-http/runner", "go-http/lint"]},
    "go-sql": {"checks": ["go-sql/root", "go-sql/runner", "go-sql/lint"]},
    "go-vuln": {"checks": ["go-vuln/root", "go-vuln/runner", "go-vuln/lint"]},
    "workflow-lint": {"checks": ["workflow-lint"]},
    "self-test": {"checks": ["self-test"]},
    "semantic-lint": {"checks": ["semantic-lint"]},
    "branch": {"checks": ["go-lint/root", "go-lint/runner", "go-lint/lint", "go-vet/root", "go-vet/runner", "go-vet/lint", "workflow-lint"]},
    "pre-merge": {"checks": ["go-lint/root", "go-lint/runner", "go-lint/lint", "go-vet/root", "go-vet/runner", "go-vet/lint", "workflow-lint", "self-test"]},
    "main": {"checks": ["go-lint/root", "go-lint/runner", "go-lint/lint", "go-vet/root", "go-vet/runner", "go-vet/lint", "workflow-lint", "self-test", "go-vuln/root", "go-vuln/runner", "go-vuln/lint"], "rerun_checks": true}
  }
}
