#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# Build through Go's incremental cache. Keep the binary outside source inputs.
cache_root=${XDG_CACHE_HOME:-${HOME}/.cache}
key=$(printf '%s' "$root" | cksum | awk '{print $1}')
bin_dir="$cache_root/levenshtein/bin/$key"
mkdir -p "$bin_dir"
required=$(<"$root/.go-version")
if [[ $(go env GOVERSION) != "go$required" ]]; then
  echo "Go $required is required. See docs/setup.md." >&2
  exit 2
fi
(cd "$root" && GOWORK=off GOTOOLCHAIN=local go build -o "$bin_dir/levenshtein" ./cmd/levenshtein)
exec "$bin_dir/levenshtein" --shared "$root" --source "$root" "$@"
