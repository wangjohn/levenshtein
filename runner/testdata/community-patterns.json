  "selection": [
    {"name": "a namespace glob selects its rules", "patterns": ["errs_*"], "code": "errs_nopanic", "want": true},
    {"name": "a namespace glob leaves another namespace alone", "patterns": ["errs_*"], "code": "sql_rows", "want": false},
