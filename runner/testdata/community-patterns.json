    {"name": "a later name turns a negated rule back on", "patterns": ["errs_*", "-errs_nopanic", "errs_nopanic"], "code": "errs_nopanic", "want": true},
    {"name": "a later glob turns a negated rule back on", "patterns": ["-errs_nopanic", "errs_*"], "code": "errs_nopanic", "want": true},
    {"name": "nothing is on by default", "patterns": [], "code": "errs_nopanic", "want": false}
