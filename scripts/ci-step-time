#!/usr/bin/env bash
# Time a CI step and append a markdown table row to GITHUB_STEP_SUMMARY.
# Usage: ci-step-time <label> <command> [args...]
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "usage: $0 <label> <command> [args...]" >&2
  exit 2
fi

label=$1
shift

if [[ -n ${GITHUB_STEP_SUMMARY:-} ]]; then
  header_marker="${RUNNER_TEMP:-/tmp}/levenshtein-ci-timing-header"
  if [[ ! -f $header_marker ]]; then
    {
      echo '### Step timings'
      echo
      echo '| Step | Seconds |'
      echo '| --- | ---: |'
    } >>"$GITHUB_STEP_SUMMARY"
    : >"$header_marker"
  fi
fi

start=$(date +%s)
set +e
"$@"
status=$?
set -e
elapsed=$(($(date +%s) - start))

if [[ -n ${GITHUB_STEP_SUMMARY:-} ]]; then
  printf '| %s | %s |\n' "$label" "$elapsed" >>"$GITHUB_STEP_SUMMARY"
fi

echo "ci-step-time: ${label}=${elapsed}s" >&2
exit "$status"
