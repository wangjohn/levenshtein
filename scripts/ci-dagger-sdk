#!/usr/bin/env bash
# Restore or generate the Dagger Go SDK for Levenshtein CI.
#
# Cached paths (exact Actions cache key only — never use restore-keys):
#   runner/dagger.gen.go
#   runner/internal/dagger/
#   runner/internal/telemetry/
#
# Actions key version: dagger-sdk-v2-… (bump the version prefix in
# .github/actions/dagger-sdk/action.yml when a key is poisoned with incomplete
# artifacts — Actions cannot overwrite an existing exact key).
#
# Invalidate the cache when any of these change (keep in sync with
# hashFiles in .github/actions/dagger-sdk/action.yml):
#   dagger.json
#   .dagger-version
#   scripts/dagger-checksums.txt
#   runner/go.mod
#   runner/go.sum
#   runner/toolchain.json
#   runner/*.go
#   sdk/patched-go/**
#
# A restored SDK is usable exactly when the runner module compiles against it,
# so compiling is the readiness test. It needs no Dagger session, the same way
# scripts/test-sdk-security builds the runner outside one. Anything that does
# not compile is regenerated.
#
# Warm verification: on a second trusted run with unchanged inputs the Generate
# step reports a reused SDK (no dagger develop) and the Save generated Dagger
# SDK step is skipped (cache-hit).
#
# Usage: ci-dagger-sdk <cache-hit true|false>
#
# When GITHUB_OUTPUT is set, writes ready=true|false for the workflow save step.
set -euo pipefail

root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

if [[ $# -ne 1 ]]; then
  echo "usage: $0 <cache-hit true|false>" >&2
  exit 2
fi

# actions/cache/restore leaves cache-hit empty on miss.
cache_hit=$1
if [[ $cache_hit != true ]]; then
  cache_hit=false
fi

# Build into a scratch directory so a passing check never leaves an executable
# in the checkout, then compile the test files without running any test. A
# plain compile is the whole contract: vet would turn an ordinary diagnostic,
# including one in generated code, into a false "SDK broken" failure.
sdk_compiles() {
  local output status=0
  output=$(mktemp -d)
  (cd runner && go build -o "$output/" ./... && go test -count=1 -run '^$' ./...) || status=$?
  rm -rf "$output"
  return "$status"
}

# Keep the cached telemetry path present for actions/cache even when codegen
# omits sources there (common with the patched Go SDK).
ensure_cache_paths() {
  mkdir -p runner/internal/dagger runner/internal/telemetry
}

emit() {
  local name=$1
  local value=$2
  if [[ -n ${GITHUB_OUTPUT:-} ]]; then
    echo "$name=$value" >>"$GITHUB_OUTPUT"
  fi
}

if [[ $cache_hit == true ]] && sdk_compiles; then
  ensure_cache_paths
  emit ready true
  echo 'ci-dagger-sdk: restored SDK compiles; skipping dagger develop' >&2
  exit 0
fi

if [[ $cache_hit == true ]]; then
  echo 'ci-dagger-sdk: restored SDK does not compile; regenerating (bump dagger-sdk-vN if this persists)' >&2
fi

dagger develop --compat=skip

if ! sdk_compiles; then
  emit ready false
  echo 'ci-dagger-sdk: dagger develop did not produce a runner that compiles' >&2
  exit 1
fi

ensure_cache_paths
emit ready true
