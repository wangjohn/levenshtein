#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT
cat > "$temporary/dagger" <<'SH'
#!/usr/bin/env bash
if [[ $1 == version ]]; then
  printf 'dagger v%s mock\n' "$TEST_DAGGER_VERSION"
else
  printf '%s\n' "$@"
fi
SH
chmod +x "$temporary/dagger"
export PATH="$temporary:$PATH"
export TEST_DAGGER_VERSION
TEST_DAGGER_VERSION=$(<"$root/.dagger-version")
"$root/verify" custom-audit > "$temporary/first"
"$root/verify" custom-audit > "$temporary/second"
grep -q -- '--audit-nonce' "$temporary/first"
if cmp -s "$temporary/first" "$temporary/second"; then
  echo 'Repeated custom runs reused their audit nonce' >&2
  exit 1
fi
if grep -qx -- '--nonce' "$temporary/first"; then
  echo 'Ordinary checks unexpectedly forced fresh execution' >&2
  exit 1
fi
"$root/verify" custom-audit --dry-run > "$temporary/plan"
if grep -q -- '--audit-nonce' "$temporary/plan"; then
  echo 'Dry planning unexpectedly acquired a nonce' >&2
  exit 1
fi
echo 'Audit nonce launcher checks passed'
