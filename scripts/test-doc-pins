#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# Consumer examples must pin the newest release in CHANGELOG.md, so a release
# pull request that moves the changelog also moves every copy-paste example.
# docs/releases.md describes that process with vX.Y.Z placeholders.
latest=$(sed -nE 's/^## \[([0-9]+\.[0-9]+\.[0-9]+)\].*/\1/p' "$root/CHANGELOG.md" | head -n 1)
if [[ -z $latest ]]; then
  echo 'CHANGELOG.md names no released version' >&2
  exit 1
fi

pins=$(git -C "$root" grep -noE \
  -e 'wangjohn/levenshtein@[^[:space:]`]+' \
  -e '--branch [^[:space:]]+ https://github\.com/wangjohn/levenshtein' \
  -- '*.md' ':!CHANGELOG.md' ':!docs/releases.md' || true)
if [[ -z $pins ]]; then
  echo 'No Levenshtein pins found in the documentation; update this check' >&2
  exit 1
fi

stale=$(grep -vE "(@|--branch )v${latest//./\\.}( |$)" <<< "$pins" || true)
if [[ -n $stale ]]; then
  echo "Documentation pins must name v$latest, the newest release in CHANGELOG.md:" >&2
  echo "$stale" >&2
  exit 1
fi
echo "Documentation pins name v$latest"
