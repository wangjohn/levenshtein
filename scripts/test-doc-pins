#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# Consumer examples and templates pin one Levenshtein release, the newest one
# CHANGELOG.md names that has been tagged:
#
#   uses: wangjohn/levenshtein@<the tag's full commit SHA> # vX.Y.Z
#   git clone --branch vX.Y.Z https://github.com/wangjohn/levenshtein
#
# A SHA is immutable where a tag can be moved, and the comment keeps it
# readable. The SHA must be the commit the tag names, checked against a local
# tag or, without one, the repository's published tags. A release pull request
# renames [Unreleased] before its tag exists, so until the tag is pushed the
# examples may still name the previous release; once it exists they must move.
# docs/releases.md describes that process with vX.Y.Z placeholders.
remote=${LEVENSHTEIN_TAGS_REMOTE:-https://github.com/wangjohn/levenshtein.git}

releases=$(sed -nE 's/^## \[([0-9]+\.[0-9]+\.[0-9]+)\].*/\1/p' "$root/CHANGELOG.md")
latest=$(sed -n 1p <<<"$releases")
previous=$(sed -n 2p <<<"$releases")
if [[ -z $latest ]]; then
  echo 'CHANGELOG.md names no released version' >&2
  exit 1
fi

# tag_commit VERSION prints the commit vVERSION names, "absent" when the tag
# does not exist, or "unknown" when neither a local tag nor the remote answers.
tag_commit() {
  local tag=v$1 listing commit
  if commit=$(git -C "$root" rev-parse --verify --quiet "refs/tags/$tag^{commit}"); then
    echo "$commit"
    return
  fi
  if ! listing=$(git ls-remote --tags "$remote" "refs/tags/$tag" "refs/tags/$tag^{}" 2> /dev/null); then
    echo unknown
    return
  fi
  if [[ -z $listing ]]; then
    echo absent
    return
  fi
  # An annotated tag lists its peeled commit as tag^{}; a lightweight one only
  # itself.
  commit=$(awk -v peeled="refs/tags/$tag^{}" '$2 == peeled { print $1 }' <<<"$listing")
  if [[ -z $commit ]]; then
    commit=$(awk '{ print $1; exit }' <<<"$listing")
  fi
  echo "$commit"
}

# shellcheck disable=SC2016 # the backquotes end Markdown code spans
pins=$(git -C "$root" grep -noE \
  -e 'wangjohn/levenshtein@[^[:space:]`]+( # [^[:space:]`]+)?' \
  -e '--branch [^[:space:]]+ https://github\.com/wangjohn/levenshtein' \
  -- '*.md' 'templates/**' ':!CHANGELOG.md' ':!docs/releases.md' || true)
if [[ -z $pins ]]; then
  echo 'No Levenshtein pins found in the documentation; update this check' >&2
  exit 1
fi

status=0
action_pins=$(grep -F 'wangjohn/levenshtein@' <<<"$pins" || true)
malformed=$(grep -vE 'wangjohn/levenshtein@[0-9a-f]{40} # v[0-9]+\.[0-9]+\.[0-9]+$' <<<"$action_pins" || true)
if [[ -n $malformed ]]; then
  echo 'Action pins must name the release commit SHA with its tag as a comment (wangjohn/levenshtein@<sha> # vX.Y.Z):' >&2
  echo "$malformed" >&2
  status=1
fi

# Every pin names one version.
versions=$({
  sed -nE 's/.*wangjohn\/levenshtein@[^[:space:]]* # v([0-9.]+)$/\1/p' <<<"$action_pins"
  sed -nE 's/.*--branch v([0-9.]+) https:.*/\1/p' <<<"$pins"
} | sort -u)
if [[ $(wc -l <<<"$versions") -ne 1 || -z $versions ]]; then
  echo "Documentation pins must all name one release, not: $(tr '\n' ' ' <<<"$versions")" >&2
  echo "$pins" >&2
  exit 1
fi
pinned=$versions
unbranched=$(grep -F -- '--branch ' <<<"$pins" | grep -vF -- "--branch v$pinned " || true)
if [[ -n $unbranched ]]; then
  echo "Clone examples must name --branch v$pinned:" >&2
  echo "$unbranched" >&2
  status=1
fi

# The pinned release is the newest, or the one before it while the newest is
# not yet tagged.
if [[ $pinned != "$latest" ]]; then
  newest=$(tag_commit "$latest")
  if [[ $pinned != "$previous" || $newest != absent ]]; then
    echo "Documentation pins name v$pinned; they must name v$latest, the newest release in CHANGELOG.md$([[ $newest != absent && $newest != unknown ]] && echo ", tagged at $newest")." >&2
    status=1
  fi
fi

commit=$(tag_commit "$pinned")
case $commit in
  absent)
    echo "Documentation pins name v$pinned, which is not tagged." >&2
    status=1
    ;;
  unknown)
    echo "Could not resolve v$pinned locally or from $remote; the pinned SHAs are unchecked." >&2
    ;;
  *)
    wrong=$(grep -vF "wangjohn/levenshtein@$commit # v$pinned" <<<"$action_pins" || true)
    if [[ -n $wrong ]]; then
      echo "v$pinned is commit $commit; these pins name another:" >&2
      echo "$wrong" >&2
      status=1
    fi
    ;;
esac

if (( status == 0 )); then
  echo "Documentation pins name v$pinned ($commit)"
fi
exit "$status"
