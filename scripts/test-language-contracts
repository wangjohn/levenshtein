#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT
(cd "$root" && GOWORK=off GOTOOLCHAIN=local go build -o "$temporary/levenshtein" ./cmd/levenshtein)
python3 "$root/scripts/test_language_contracts.py" "$temporary/levenshtein"
