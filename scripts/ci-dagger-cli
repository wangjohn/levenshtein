#!/usr/bin/env bash
# Put the pinned Dagger CLI on PATH for a CI job.
#
# Usage: ci-dagger-cli
#
# The composite action .github/actions/setup-dagger restores the Dagger release
# archive into $RUNNER_TEMP/levenshtein-dagger-archive from the Actions cache
# first. The cache holds the archive, never an executable: scripts/install-dagger
# checks it against scripts/dagger-checksums.txt on every run, downloads it
# again when it is missing or does not match, and installs the binary from it
# into $RUNNER_TEMP/levenshtein-bin, which is appended to GITHUB_PATH.
set -euo pipefail

root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
temp=${RUNNER_TEMP:?RUNNER_TEMP is set by GitHub Actions}

DAGGER_ARCHIVE_DIR="$temp/levenshtein-dagger-archive" "$root/scripts/install-dagger" "$temp/levenshtein-bin"
echo "$temp/levenshtein-bin" >>"${GITHUB_PATH:?GITHUB_PATH is set by GitHub Actions}"
