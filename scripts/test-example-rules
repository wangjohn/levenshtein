#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT
example="$root/examples/rule-module"
# Read go.mod as text: the go command refuses a go.mod newer than itself.
module=$(awk '$1 == "module" { print $2 }' "$example/go.mod")
module_go=$(awk '$1 == "go" { print $2 }' "$example/go.mod")
go_version=$(cat "$root/.go-version")
staticcheck=$(jq -er .staticcheck "$root/runner/toolchain.json")

# A rule module must build with the Go release Levenshtein pins, so its go
# directive cannot be newer.
if [[ $(printf '%s\n' "$module_go" "$go_version" | sort -V | tail -n 1) != "$go_version" ]]; then
  echo "$module requires go $module_go, newer than the pinned go $go_version" >&2
  exit 1
fi

# The example rule module is the template community rule authors copy, so it
# has to keep passing its own tests. See docs/community-rules.md.
(cd "$example" && go test -race ./...)

# Build the example into a community linter with the same builder the Dagger
# runner uses (runner/community/cmd/levenshtein-community-build): its own
# process on the pinned Staticcheck, every rule renamed into the module's
# namespace, and a resolution that moves no pin. The example is not tagged, so
# it is replaced by its directory; everything else resolves as for any module.
mkdir "$temporary/consumer" "$temporary/out"
jq -n --arg go "$go_version" --arg staticcheck "$staticcheck" --arg community "$root/runner/community" \
  --arg module "$module" --arg dir "$example" \
  '{go: $go, staticcheck: $staticcheck, community: $community,
    modules: [{path: $module, version: "v0.0.0", namespace: "example", dir: $dir}]}' > "$temporary/request.json"
(cd "$root/runner/community" && go run ./cmd/levenshtein-community-build -request "$temporary/request.json" -out "$temporary/out")
jq -n --arg module "$module" \
  '{modules: [{path: $module, version: "v0.0.0", namespace: "example", select: ["example_*"]}]}' > "$temporary/config.json"

# The built linter reports the rule under its namespaced code, and honors
# //lint:ignore for it.
printf 'module example.com/consumer\n\ngo %s\n' "$go_version" > "$temporary/consumer/go.mod"
cat > "$temporary/consumer/store.go" <<'GO'
package store

func Load(key string) int {
	if key == "" {
		panic("empty key")
	}
	return len(key)
}

func Port(value int) int {
	if value < 0 {
		//lint:ignore example_nopanic callers validate the port first
		panic("negative port")
	}
	return value
}
GO
status=0
(cd "$temporary/consumer" && STATICCHECK_CACHE="$temporary/staticcheck" "$temporary/out/levenshtein-community-lint" \
  -lvrules.config="$temporary/config.json" -lvrules.report="$temporary/report.json" ./...) > "$temporary/findings.txt" 2>&1 || status=$?
expected='store.go:5:3: Load panics; return an error so callers can handle the failure (example_nopanic)'
if [[ $status -ne 1 || $(cat "$temporary/findings.txt") != "$expected" ]]; then
  echo "The community linter built from $module reported (exit $status):" >&2
  cat "$temporary/findings.txt" >&2
  echo "expected exactly: $expected" >&2
  exit 1
fi
if [[ $(jq -r '.rules[0] | "\(.code) \(.url)"' "$temporary/report.json") != "example_nopanic https://pkg.go.dev/$module/nopanic" ]]; then
  echo "The community linter's report does not describe example_nopanic:" >&2
  cat "$temporary/report.json" >&2
  exit 1
fi
echo "$module passes its tests and builds into a community linter on Staticcheck $staticcheck"
