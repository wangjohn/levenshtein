#!/usr/bin/env bash
set -euo pipefail
metadata_only=false
if [[ ${1:-} == --metadata-only ]]; then
  metadata_only=true
  shift
fi
if [[ $# != 1 ]]; then
  echo 'Usage: scripts/test-release [--metadata-only] ARCHIVE.tar.gz' >&2
  exit 2
fi
archive=$(cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT
mkdir "$temporary/shared" "$temporary/app"
tar -xzf "$archive" -C "$temporary/shared"
shared="$temporary/shared"
for file in levenshtein README.md LICENSE NOTICE CHANGELOG.md CONTRIBUTING.md SECURITY.md CODE_OF_CONDUCT.md AGENTS.md runner/checks.go runner/rule-modules.json runner/community/go.mod sdk/patched-go/dagger.json sdk/patched-go/pyproject.toml sdk/patched-go/uv.lock sdk/patched-go/src/patched_go/__init__.py; do
  test -f "$shared/$file" || { echo "Archive missing $file" >&2; exit 1; }
done
# The Dagger module compiles every non-test Go file in runner/, and the archive
# lists them one by one, so a new file has to be added to .goreleaser.yaml too.
root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# Each pinned Go tool builds from a module of its own under runner/tools.
for module in "$root"/runner/tools/*/go.mod "$root"/runner/tools/*/go.sum; do
  file=${module#"$root"/}
  test -f "$shared/$file" || { echo "Archive missing $file" >&2; exit 1; }
done
for source in "$root"/runner/*.go; do
  file=runner/$(basename -- "$source")
  [[ $file == *_test.go || $file == runner/dagger.gen.go ]] && continue
  test -f "$shared/$file" || { echo "Archive missing $file; add it to .goreleaser.yaml" >&2; exit 1; }
done
# The runner imports its generated copy of internal/checktool.
for source in "$root"/runner/internal/checktool/*.go; do
  file=${source#"$root"/}
  test -f "$shared/$file" || { echo "Archive missing $file; add it to .goreleaser.yaml" >&2; exit 1; }
done
# Dagger's Python runtime installs the SDK adapter from these files, and
# without uv.lock it resolves the adapter's dependencies from PyPI on every
# run, so every tracked file but its .gitignore ships.
while IFS= read -r file; do
  [[ $(basename -- "$file") == .gitignore ]] && continue
  test -f "$shared/$file" || { echo "Archive missing $file; add it to .goreleaser.yaml" >&2; exit 1; }
done < <(git -C "$root" ls-files sdk/patched-go)
# Consumer templates and every published documentation page are part of the
# archive contract. Compare with tracked files, not generated local output.
while IFS= read -r file; do
  test -f "$shared/$file" || { echo "Archive missing $file; add it to .goreleaser.yaml" >&2; exit 1; }
done < <(git -C "$root" ls-files docs templates)
# Reuse the Markdown checker, but resolve paths and anchors only in the extracted
# archive. -count=1 prevents a cached checkout result from masking missing files.
(cd "$root" && LEVENSHTEIN_DOC_ROOT="$shared" GOTOOLCHAIN=local go test -count=1 ./internal/doccheck -run '^TestRelativeLinksResolve$')
echo 'Extracted release archive passed metadata checks'
if [[ $metadata_only == true ]]; then
  exit 0
fi
# Run only the extracted binary and sources, outside the repository checkout.
cd "$temporary"
cp "$shared/runner/testdata/resources-good/"* app/
cat > app/levenshtein.json <<'JSON'
{"version":1,"targets":{"app":{"dir":".","inputs":["."]}},"environments":{"go":{"executor":"dagger"}},"checks":{"lint":{"kind":"go-lint","target":"app","environment":"go"},"http":{"kind":"go-http","target":"app","environment":"go"}},"runs":{"branch":{"checks":["lint","http"]}}}
JSON
"$shared/levenshtein" branch --source "$temporary/app" --shared "$shared" --dry-run
"$shared/levenshtein" branch --source "$temporary/app" --shared "$shared" --cache-dir "$temporary/cache" > good.json
mkdir bad
cp "$shared/runner/testdata/resources-bad/"* bad/
cp app/levenshtein.json bad/
status=0
"$shared/levenshtein" branch --source "$temporary/bad" --shared "$shared" --cache-dir "$temporary/cache" > bad.json || status=$?
if [[ $status != 1 ]] || ! grep -q '"code": "bodyclose"' bad.json; then
  cat bad.json
  echo "Expected packaged HTTP cleanup finding, got exit $status" >&2
  exit 1
fi
echo 'Extracted release archive passed consumer smoke checks'
