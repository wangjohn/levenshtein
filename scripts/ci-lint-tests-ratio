#!/usr/bin/env bash
# Publish lint vs tests wall-clock ratio for this workflow run.
# Usage: ci-lint-tests-ratio <lint-seconds> <tests-seconds>
# Empty or non-numeric values are treated as unavailable.
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: $0 <lint-seconds> <tests-seconds>" >&2
  exit 2
fi

lint=$1
tests=$2

numeric() {
  [[ $1 =~ ^[0-9]+$ ]]
}

if [[ -n ${GITHUB_STEP_SUMMARY:-} ]]; then
  {
    echo '## Lint vs tests (this run)'
    echo
    echo '| Job | Seconds |'
    echo '| --- | ---: |'
    if numeric "$lint"; then
      printf '| lint | %s |\n' "$lint"
    else
      echo '| lint | n/a |'
    fi
    if numeric "$tests"; then
      printf '| tests | %s |\n' "$tests"
    else
      echo '| tests | n/a |'
    fi
    echo
    if numeric "$lint" && numeric "$tests" && (( tests > 0 )); then
      # Bash integer ratio ×100 for two decimal places without bc.
      ratio_x100=$((lint * 10000 / tests))
      whole=$((ratio_x100 / 100))
      frac=$((ratio_x100 % 100))
      printf -v frac '%02d' "$frac"
      echo "lint/tests ratio: **${whole}.${frac}** (aim: warm lint ≪ tests; treat lint creeping toward tests as a regression)."
    else
      echo 'lint/tests ratio: unavailable for this run.'
    fi
    echo
    echo 'Compare medians across warm `ubuntu-24.04` runs; a single cold miss is not a regression by itself.'
  } >>"$GITHUB_STEP_SUMMARY"
fi

echo "ci-lint-tests-ratio: lint=${lint:-n/a} tests=${tests:-n/a}" >&2
