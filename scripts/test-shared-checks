#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT

(cd "$root" && go build -o "$temporary/verify" ./cmd/levenshtein)
for fixture in resources-good resources-bad vet-bad mod-tidy mod-untidy test-pass test-fail workflow-secure workflow-insecure shell-good shell-bad secrets-clean secrets-leaky deps-clean deps-vulnerable good bad; do
  mkdir -p "$temporary/$fixture"
  cp -R "$root/runner/testdata/$fixture/." "$temporary/$fixture/"
  # The dependency fixtures are stored as *.fixture so GitHub's dependency
  # graph never reads them; scan them under their real names.
  for stored in "$temporary/$fixture"/*.fixture; do
    if [[ -e $stored ]]; then
      mv "$stored" "${stored%.fixture}"
    fi
  done
  cat > "$temporary/$fixture/levenshtein.json" <<'JSON'
{"version":1,"targets":{"app":{"dir":".","inputs":["."]}},"environments":{"go":{"executor":"dagger"},"host":{"executor":"native"},"host-net":{"executor":"native","pass_env":["HTTPS_PROXY","https_proxy","NO_PROXY","no_proxy"]}},"checks":{"http":{"kind":"go-http","target":"app","environment":"go"},"sql":{"kind":"go-sql","target":"app","environment":"go"},"vet":{"kind":"go-vet","target":"app","environment":"go"},"mod":{"kind":"go-mod","target":"app","environment":"go"},"test":{"kind":"go-test","target":"app","environment":"go"},"security":{"kind":"workflow-security","target":"app","environment":"go"},"shell":{"kind":"shell-lint","target":"app","environment":"go"},"secrets":{"kind":"secrets","target":"app","environment":"go"},"deps":{"kind":"deps-vuln","target":"app","environment":"go"},"native-vet":{"kind":"go-vet","target":"app","environment":"host"},"native-mod":{"kind":"go-mod","target":"app","environment":"host"},"native-test":{"kind":"go-test","target":"app","environment":"host"},"native-lint":{"kind":"go-lint","target":"app","environment":"host"},"native-security":{"kind":"workflow-security","target":"app","environment":"host"},"native-shell":{"kind":"shell-lint","target":"app","environment":"host"},"native-secrets":{"kind":"secrets","target":"app","environment":"host"},"native-deps":{"kind":"deps-vuln","target":"app","environment":"host-net"}},"runs":{"http":{"checks":["http"]},"sql":{"checks":["sql"]},"vet":{"checks":["vet"]},"mod":{"checks":["mod"]},"test":{"checks":["test"]},"security":{"checks":["security"]},"shell":{"checks":["shell"]},"secrets":{"checks":["secrets"]},"deps":{"checks":["deps"]},"native-vet":{"checks":["native-vet"]},"native-mod":{"checks":["native-mod"]},"native-test":{"checks":["native-test"]},"native-lint":{"checks":["native-lint"]},"native-security":{"checks":["native-security"]},"native-shell":{"checks":["native-shell"]},"native-secrets":{"checks":["native-secrets"]},"native-deps":{"checks":["native-deps"]}}}
JSON
done
for check in http sql vet mod test security shell secrets deps; do
  clean=resources-good
  fixture=resources-bad
  case "$check" in
    http) code=bodyclose ;;
    sql) code=sqlclosecheck ;;
    vet) fixture=vet-bad; code=go-vet ;;
    mod) clean=mod-tidy; fixture=mod-untidy; code=go-mod ;;
    test) clean=test-pass; fixture=test-fail; code=go-test ;;
    security) clean=workflow-secure; fixture=workflow-insecure; code=workflow-security ;;
    shell) clean=shell-good; fixture=shell-bad; code=SC2164 ;;
    secrets) clean=secrets-clean; fixture=secrets-leaky; code=generic-api-key ;;
    deps) clean=deps-clean; fixture=deps-vulnerable; code=deps-vuln ;;
  esac
  "$temporary/verify" "$check" --source "$temporary/$clean" --shared "$root" --cache-dir "$temporary/cache" > "$temporary/good.json"
  status=0
  "$temporary/verify" "$check" --source "$temporary/$fixture" --shared "$root" --cache-dir "$temporary/cache" > "$temporary/bad.json" || status=$?
  if [[ $status != 1 ]] || ! grep -q "\"code\": \"$code\"" "$temporary/bad.json"; then
    cat "$temporary/bad.json"
    echo "Expected $check finding through the current CLI, got exit $status" >&2
    exit 1
  fi
done
# The same fixtures through the native executor, which needs no container. Only
# the kinds a native environment runs appear here.
for check in native-lint native-vet native-mod native-test native-security native-shell native-secrets native-deps; do
  case "$check" in
    native-lint) clean=good; broken=bad; code=SA5001 ;;
    native-vet) clean=resources-good; broken=vet-bad; code=go-vet ;;
    native-mod) clean=mod-tidy; broken=mod-untidy; code=go-mod ;;
    native-test) clean=test-pass; broken=test-fail; code=go-test ;;
    native-security) clean=workflow-secure; broken=workflow-insecure; code=workflow-security ;;
    native-shell) clean=shell-good; broken=shell-bad; code=SC2164 ;;
    native-secrets) clean=secrets-clean; broken=secrets-leaky; code=generic-api-key ;;
    native-deps) clean=deps-clean; broken=deps-vulnerable; code=deps-vuln ;;
  esac
  "$temporary/verify" "$check" --source "$temporary/$clean" --shared "$root" --cache-dir "$temporary/native-cache" > "$temporary/good.json"
  status=0
  "$temporary/verify" "$check" --source "$temporary/$broken" --shared "$root" --cache-dir "$temporary/native-cache" > "$temporary/bad.json" || status=$?
  if [[ $status != 1 ]] || ! grep -q "\"code\": \"$code\"" "$temporary/bad.json"; then
    cat "$temporary/bad.json"
    echo "Expected $check finding through the native executor, got exit $status" >&2
    exit 1
  fi
done
echo 'Shared-check CLI integration passed'
