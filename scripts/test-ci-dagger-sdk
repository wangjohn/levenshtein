#!/usr/bin/env bash
# Fixture checks for scripts/ci-dagger-sdk readiness (no dagger develop).
set -euo pipefail

root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=ci-dagger-sdk
source "$root/scripts/ci-dagger-sdk"

temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT
cd "$temporary"

write_bytes() {
  local path=$1
  local nbytes=$2
  local header=$3
  mkdir -p "$(dirname "$path")"
  python3 - "$path" "$nbytes" "$header" <<'PY'
import pathlib, sys
path, nbytes, header = pathlib.Path(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
body = header.encode() + b"\n"
pad = max(0, nbytes - len(body))
path.write_bytes(body + (b"x" * pad))
PY
}

assert_ready() {
  local label=$1
  local want=$2
  if sdk_ready; then
    got=pass
  else
    got=fail
  fi
  if [[ $got != "$want" ]]; then
    echo "test-ci-dagger-sdk: $label: want $want, got $got ($(sdk_stats) = gen_bytes dagger_go telemetry_go total_kb)" >&2
    exit 1
  fi
}

# Observed cold-CI post-develop layout (run 35427803159):
#   7448 1 0 436 = gen_bytes dagger_go telemetry_go total_kb
mkdir -p runner/internal/dagger
write_bytes runner/dagger.gen.go 7448 'package main'
# ~429KiB single dagger source (436 total - ~7KiB gen), no telemetry dir/files.
write_bytes runner/internal/dagger/client.go $((429 * 1024)) 'package dagger'
assert_ready 'real-ci-layout' pass

# Same layout with an empty telemetry directory still passes.
mkdir -p runner/internal/telemetry
assert_ready 'real-ci-layout-empty-telemetry' pass

# ~59KiB poison-sized tree must stay rejected.
rm -rf runner
mkdir -p runner/internal/dagger runner/internal/telemetry
write_bytes runner/dagger.gen.go 4096 'package main'
write_bytes runner/internal/dagger/stub.go $((50 * 1024)) 'package dagger'
assert_ready 'poison-sized' fail

echo 'test-ci-dagger-sdk: ok'
