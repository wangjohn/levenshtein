#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT
cd "$root"

# The adapter's Python dependencies install from its lock on every Dagger run.
"$root/scripts/test-sdk-lock"

# A second generation must preserve the fix, not restore Dagger's old overrides.
dagger develop --compat=skip
dagger develop --compat=skip

modules=(
  go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc
  go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploghttp
  go.opentelemetry.io/otel/log
  go.opentelemetry.io/otel/sdk/log
)
for module in "${modules[@]}"; do
  version=$(cd runner && go list -m -f '{{if .Replace}}{{.Replace.Version}}{{else}}{{.Version}}{{end}}' "$module")
  if [[ "$version" != v0.20.0 ]]; then
    echo "Unexpected effective version of $module: $version (want v0.20.0)" >&2
    exit 1
  fi
done

# Scan the generated executable as well as the source checks in ./verify go-vuln.
(cd runner && go build -o "$temporary/runtime" .)
(cd runner/tools && go build -o "$temporary/govulncheck" golang.org/x/vuln/cmd/govulncheck)
"$temporary/govulncheck" -mode=binary "$temporary/runtime"

# The tools runner/tools pins (gremlins, gitleaks, actionlint, apidiff,
# govulncheck) run over consumer source, so scan what they compile to as well:
# a tools module has no code of its own for a source scan to follow.
mkdir "$temporary/tools"
tools=()
while IFS= read -r tool; do
  tools+=("$tool")
done < <(cd runner/tools && go list tool)
if (( ${#tools[@]} == 0 )); then
  echo 'runner/tools declares no tools; update this check' >&2
  exit 1
fi
(cd runner/tools && go build -o "$temporary/tools/" "${tools[@]}")
for binary in "$temporary"/tools/*; do
  echo "Scanning $(basename -- "$binary")"
  "$temporary/govulncheck" -mode=binary "$binary"
done
