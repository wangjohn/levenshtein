#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT
cd "$root"

# The adapter's Python dependencies install from its lock on every Dagger run.
"$root/scripts/test-sdk-lock"

# A second generation must preserve the fix, not restore Dagger's old overrides.
dagger develop --compat=skip
dagger develop --compat=skip

modules=(
  go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc
  go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploghttp
  go.opentelemetry.io/otel/log
  go.opentelemetry.io/otel/sdk/log
)
for module in "${modules[@]}"; do
  version=$(cd runner && go list -m -f '{{if .Replace}}{{.Replace.Version}}{{else}}{{.Version}}{{end}}' "$module")
  if [[ "$version" != v0.21.0 ]]; then
    echo "Unexpected effective version of $module: $version (want v0.21.0)" >&2
    exit 1
  fi
done

modules=(
  go.opentelemetry.io/otel/exporters/otlp/otlptrace
  go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc
  go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp
)
for module in "${modules[@]}"; do
  version=$(cd runner && go list -m -f '{{.Version}}' "$module")
  if [[ "$version" != v1.45.0 ]]; then
    echo "Unexpected effective version of $module: $version (want v1.45.0)" >&2
    exit 1
  fi
done

# The telemetry fork must remain the shipped compatibility patch after both
# generations, rather than reverting to a module with the removed logging API.
telemetry=$(cd runner && go list -m -f '{{if .Replace}}{{.Replace.Dir}}{{end}}' github.com/dagger/otel-go)
if [[ "$telemetry" != "$root/sdk/patched-go/otel-go" ]]; then
  echo "Unexpected telemetry replacement: $telemetry" >&2
  exit 1
fi
(cd sdk/patched-go/otel-go && go test ./...)

# Scan the generated executable as well as the source checks in ./verify go-vuln.
(cd runner && go build -o "$temporary/runtime" .)
(cd runner/tools/govulncheck && go build -o "$temporary/govulncheck" golang.org/x/vuln/cmd/govulncheck)
"$temporary/govulncheck" -mode=binary "$temporary/runtime"

# The tools pinned under runner/tools (gremlins, gitleaks, actionlint,
# apidiff, govulncheck), one module each, run over consumer source, so scan
# what they compile to as well: a tool module has no code of its own for a
# source scan to follow.
mkdir "$temporary/tools"
modules=(runner/tools/*/go.mod)
if [[ ! -f ${modules[0]} ]]; then
  echo 'runner/tools holds no tool modules; update this check' >&2
  exit 1
fi
for module in "${modules[@]}"; do
  directory=$(dirname -- "$module")
  (cd "$directory" && go build -o "$temporary/tools/" tool)
done
for binary in "$temporary"/tools/*; do
  echo "Scanning $(basename -- "$binary")"
  "$temporary/govulncheck" -mode=binary "$binary"
done
