#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT
(cd "$root/runner/lint" && go build -o "$temporary/lint" ./cmd/levenshtein-lint)

# The default selection in runner/toolchain.json, spelled the way the linter takes it.
checks='all,-ST1000,-ST1003,-ST1016,-ST1020,-ST1021,-ST1022,-gocognit,-deferInLoop'

# One triggering case per default rule. This list mirrors expectedBadCodes in
# runner/main.go, so a rule that stops running fails here without Dagger too.
expected='SA4006 SA5001 SA5003 SA9001 S1002 ST1005 QF1011 U1000
bodyclose sqlclosecheck rowserrcheck noctx contextcheck
errcheck exhaustive nilness unusedwrite errorlint nilerr durationcheck reassign wastedassign musttag recvcheck nilnesserr fatcontext scannererr reflectvaluecompare gochecksumtype
appendAssign argOrder badCall badCond badRegexp badSyncOnceFunc codegenComment deprecatedComment dupArg dupBranchBody dupCase evalOrder exitAfterDefer filepathJoin flagDeref flagName mapKey offBy1 rangeAppendAll returnAfterHttpError
zerologlint loggercheck
bidichk gocheckcompilerdirectives
unparam
intrange usestdlibvars perfsprint predeclared errname exptostd
minmax mapsloop slicescontains stringscutprefix stringsseq
thelper tparallel testifylint usetesting testableexamples
LV1001 LV1002 LV1003 LV1004 LV1005 LV1006'

(cd "$root/runner/testdata/good" && "$temporary/lint" -checks="$checks" ./...)
(cd "$root/runner/testdata/vendored" && "$temporary/lint" -checks="$checks" ./...)
(cd "$root/runner/testdata/embedded" && "$temporary/lint" -checks="$checks" ./...)
# The modernize rules check the file's Go version, so the same patterns pass under go 1.19.
(cd "$root/runner/testdata/modernize-legacy" && "$temporary/lint" -checks="$checks" ./...)
# scripts/test-release lints this fixture with the defaults, so it has to pass both.
(cd "$root/runner/testdata/resources-good" && "$temporary/lint" -checks=bodyclose,sqlclosecheck ./...)
(cd "$root/runner/testdata/resources-good" && "$temporary/lint" -checks="$checks" ./...)
# gocognit is registered but off by default, so its fixture passes the default.
(cd "$root/runner/testdata/complexity" && "$temporary/lint" -checks="$checks" ./...)
# deferInLoop is registered but off by default too.
(cd "$root/runner/testdata/defer-loop" && "$temporary/lint" -checks="$checks" ./...)

# fails runs a command in a fixture and requires it to fail, keeping the output.
fails() {
  local fixture=$1
  shift
  if (cd "$root/runner/testdata/$fixture" && "$@") > "$temporary/output" 2>&1; then
    echo "$fixture unexpectedly passed" >&2
    exit 1
  fi
}

# reported requires the last failing output to contain a line matching pattern.
reported() {
  if ! grep -qE -- "$1" "$temporary/output"; then
    cat "$temporary/output" >&2
    echo "Missing intended diagnostic: $2" >&2
    exit 1
  fi
}

# expect_failure requires each code as a whole diagnostic code: the linter ends
# every finding with "(code)", so nilness is not satisfied by nilnesserr.
expect_failure() {
  local fixture=$1 codes=$2
  shift 2
  fails "$fixture" "$@"
  for code in $codes; do
    reported "\\($code\\)\$" "$code"
  done
}

expect_failure bad "$expected" "$temporary/lint" -checks="$checks" ./...
# The linter sees cgo/cgo.go through cgo's rewrite, which lives in the build cache
# and is marked generated: its findings must still report, against the original.
reported '^cgo/cgo\.go:[0-9]+:[0-9]+: .*\(SA4006\)$' 'SA4006 in the hand-written cgo file'
reported '^cgo/cgo\.go:[0-9]+:[0-9]+: .*\(exhaustive\)$' 'exhaustive in the hand-written cgo file'
# good/ignored.go suppresses a nilerr finding with //lint:ignore; a nilerr
# directive with no finding under it must still be reported as unused.
reported "^correctness\\.go:58:2: this linter directive didn't match anything; should it be removed\\? \\(staticcheck\\)\$" 'unused //lint:ignore nilerr'
# good/builds.go suppresses recvcheck and unparam findings that exist in only
# one of the package's builds, with and without tests. Directives for those
# rules that match nothing in any build must still be reported, in a package
# with tests and in one without.
reported "^builds\\.go:8:1: this linter directive didn't match anything; should it be removed\\? \\(staticcheck\\)\$" 'unused //lint:ignore recvcheck'
reported "^builds\\.go:18:1: this linter directive didn't match anything; should it be removed\\? \\(staticcheck\\)\$" 'unused //lint:ignore unparam'
reported "^notests/notests\\.go:7:1: this linter directive didn't match anything; should it be removed\\? \\(staticcheck\\)\$" 'unused //lint:ignore recvcheck without tests'
# The default build leaves integration.go out, but gofmt checks it, so LV1005 does too.
reported '^integration\.go:1:1: file is not gofmt-formatted; run gofmt -w \(LV1005\)$' 'LV1005 in a file the build ignores'
if grep -q '^/' "$temporary/output"; then
  cat "$temporary/output" >&2
  echo "A bad finding points outside the fixture, such as into the build cache" >&2
  exit 1
fi
expect_failure resources-bad 'bodyclose sqlclosecheck' "$temporary/lint" -checks=bodyclose,sqlclosecheck ./...
expect_failure complexity gocognit "$temporary/lint" -checks=gocognit ./...
expect_failure complexity gocognit "$temporary/lint" -checks=all ./...
# A go-lint check's "lint": {"checks": [...]} is appended to the default, so a
# later name turns the opt-in rule back on.
expect_failure complexity gocognit "$temporary/lint" -checks="$checks,gocognit" ./...
expect_failure defer-loop deferInLoop "$temporary/lint" -checks="$checks,deferInLoop" ./...
# httpmux only reports a module whose go directive predates Go 1.22, so it has a
# fixture of its own rather than a case in bad.
expect_failure httpmux-legacy httpmux "$temporary/lint" -checks="$checks" ./...
fails vet-bad go vet ./...
reported 'passes lock by value' 'passes lock by value'

# Staticcheck caches a package's results by the files the build compiles, and
# LV1005 also reads the files the build leaves out. Formatting only such a file
# must clear its finding on the next run from the same cache.
cached="$temporary/cached"
mkdir -p "$cached/module"
printf 'module example.com/cached\n\ngo 1.27.1\n' > "$cached/module/go.mod"
printf 'package cached\n' > "$cached/module/cached.go"
printf '//go:build integration\n\npackage cached\nvar  x = 1\n' > "$cached/module/integration.go"
if (cd "$cached/module" && STATICCHECK_CACHE="$cached/cache" "$temporary/lint" -checks=LV1005 ./...) > "$temporary/output" 2>&1; then
  echo "an unformatted file the build ignores unexpectedly passed" >&2
  exit 1
fi
reported '^integration\.go:1:1: .*\(LV1005\)$' 'LV1005 in a file the build ignores'
printf '//go:build integration\n\npackage cached\n\nvar x = 1\n' > "$cached/module/integration.go"
if ! (cd "$cached/module" && STATICCHECK_CACHE="$cached/cache" "$temporary/lint" -checks=LV1005 ./...); then
  echo "a cached LV1005 finding outlived the fix to a file the build ignores" >&2
  exit 1
fi
echo 'Expanded check regression fixtures passed'
