+// httpEndpointURL preserves the pre-1.45 default path for an endpoint without
+// a path. Explicit paths, including "/", retain their existing meaning.
+func httpEndpointURL(endpoint, defaultPath string) string {
+	u, err := url.Parse(endpoint)
+	if err != nil || u.Path != "" {
+		return endpoint
+	}
+
+	u.Path = defaultPath
+	return u.String()
+}
